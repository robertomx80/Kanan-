# ==============================================
# CONFIGURACIÓN GENERAL
# ==============================================
NODE_ENV=development
APP_NAME="Price Tracking System"
APP_URL=http://localhost:3000

# ==============================================
# BACKEND (NestJS)
# ==============================================
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001

# ==============================================
# DATABASE (PostgreSQL)
# ==============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/price_tracking?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=price_tracking

# ==============================================
# REDIS
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================
# JWT & SECURITY
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRATION=30d
BCRYPT_ROUNDS=10

# ==============================================
# EMAIL (NodeMailer)
# ==============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM="Price Tracking <noreply@pricetracking.com>"

# ==============================================
# FRONTEND (React)
# ==============================================
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME="Price Tracking System"

# ==============================================
# SUSCRIPCIONES & PAGOS
# ==============================================
# Stripe
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# MercadoPago (alternativa)
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxxxxxxx
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxx

# Precios de planes (en centavos/pesos)
PLAN_FREE_MAX_PRODUCTS=1
PLAN_PREMIUM_PRICE=9900
PLAN_PREMIUM_CURRENCY=MXN

# ==============================================
# SCRAPING
# ==============================================
SCRAPER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
SCRAPER_TIMEOUT=30000
SCRAPER_MAX_RETRIES=3
SCRAPER_DELAY_BETWEEN_REQUESTS=2000

# ==============================================
# JOBS & CRON
# ==============================================
PRICE_UPDATE_CRON="0 */6 * * *"  # Cada 6 horas
NOTIFICATION_CHECK_CRON="*/15 * * * *"  # Cada 15 minutos
CLEANUP_OLD_PRICES_CRON="0 2 * * *"  # Diario a las 2 AM

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ==============================================
# FILE UPLOADS
# ==============================================
MAX_FILE_SIZE=5242880  # 5MB en bytes
UPLOAD_DIR=./uploads

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=debug  # debug | info | warn | error
